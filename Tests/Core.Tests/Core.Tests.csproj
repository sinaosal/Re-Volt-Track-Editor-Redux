<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the Unity-independent core in Assets/Scripts/Core.
    The sources are compiled directly, no Unity required. Run from the repository root:
      dotnet run (project) Tests/Core.Tests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Core.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
